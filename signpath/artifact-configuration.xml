<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- Sign only our generated executable. Never sign bundled upstream DLLs. -->
    <pe-file path="DopeWars-BFT.exe"
             product-name="Dope Wars - BFT edition"
             product-version="${version}"
             file-version="${version}"
             company-name="BFT"
             original-filename="DopeWars-BFT.exe">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
